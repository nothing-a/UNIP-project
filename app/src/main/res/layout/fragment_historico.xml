<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/espaco_menu">

        <TextView
            style="@style/Text.Project2.LargeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico" />

        <TextView
            style="@style/Text.Project2.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A evolução da sua TMB" />

        <TextView
            android:id="@+id/Vazio"
            style="@style/Text.Project2.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_card"
            android:text="Nenhum cálculo ainda.\nUse a aba Calcular para começar." />

        <LinearLayout
            android:id="@+id/Conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <!-- Resumo: valor atual, variação desde o primeiro cálculo e média -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/secondary_label"
                        android:textSize="12sp"
                        android:text="Atual" />

                    <TextView
                        android:id="@+id/Atual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/label"
                        android:textSize="17sp"
                        tools:text="1680" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/separator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/secondary_label"
                        android:textSize="12sp"
                        android:text="Variação" />

                    <TextView
                        android:id="@+id/Variacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/label"
                        android:textSize="17sp"
                        tools:text="▲ 45" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/separator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/secondary_label"
                        android:textSize="12sp"
                        android:text="Média" />

                    <TextView
                        android:id="@+id/Media"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/label"
                        android:textSize="17sp"
                        tools:text="1650" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Project2.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Gasto calórico (kcal)" />

            <br.unip.tmb.telas.componentes.GraficoHistorico
                android:id="@+id/Grafico"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:padding="16dp"
                android:background="@drawable/bg_card" />

            <TextView
                style="@style/Text.Project2.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="12sp"
                android:text="Toque ou arraste no gráfico para ver cada cálculo" />

            <TextView
                style="@style/Text.Project2.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Cálculo selecionado" />

            <!-- Preenchido pelo código com item_historico -->
            <FrameLayout
                android:id="@+id/Selecionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
